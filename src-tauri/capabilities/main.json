{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled shell can read configuration and control the managed local runtime.",
  "windows": ["main"],
  "permissions": [
    "allow-inspect-backup",
    "allow-validate-backup",
    "allow-get-backup-status",
    "allow-create-backup",
    "allow-cancel-backup",
    "allow-open-backup-folder",
    "allow-get-log-catalog",
    "allow-read-log-page",
    "allow-export-support-bundle",
    "allow-get-shell-info",
    "allow-save-app-settings",
    "allow-save-app-language",
    "allow-get-setup-info",
    "allow-save-setup-profile",
    "allow-copy-admin-password",
    "allow-get-runtime-info",
    "allow-get-runtime-startup-progress",
    "allow-start-runtime",
    "allow-stop-runtime",
    "allow-restart-runtime",
    "allow-retry-runtime-health",
    "allow-refresh-runtime-maintenance",
    "allow-get-health-diagnostics",
    "allow-get-repair-plan",
    "allow-apply-repair",
    "allow-open-wordpress",
    "allow-open-pos",
    "allow-get-provisioning-info",
    "allow-provision-wordpress"
  ]
}
